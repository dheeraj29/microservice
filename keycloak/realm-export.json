{
  "realm": "bus-reservation",
  "enabled": true,
  "displayName": "Bus Reservation Identity System",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator with full fleet and operations control"
      },
      {
        "name": "USER",
        "description": "Standard customer with ticket booking and viewing permissions"
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Spring Security mapped Admin role"
      },
      {
        "name": "ROLE_USER",
        "description": "Spring Security mapped User role"
      }
    ]
  },
  "groups": [],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@busreservation.local",
      "firstName": "Admin",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "ROLE_ADMIN",
        "USER",
        "ROLE_USER"
      ]
    },
    {
      "username": "john_doe",
      "enabled": true,
      "email": "john@example.com",
      "firstName": "John",
      "lastName": "Doe",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ROLE_USER"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "envoy-client",
      "name": "Envoy Gateway Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "envoy-client-secret-key-123",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:8080/oauth2/callback",
        "http://localhost:4200/*",
        "http://localhost:4200/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:4200",
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "angular-client",
      "name": "Angular Play UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8080/*",
        "http://localhost:8081/*",
        "http://localhost:8083/*",
        "http://localhost:8084/*",
        "http://localhost:8085/*",
        "http://localhost:8081/swagger-ui/oauth2-redirect.html",
        "http://localhost:8083/swagger-ui/oauth2-redirect.html",
        "http://localhost:8084/swagger-ui/oauth2-redirect.html",
        "http://localhost:8085/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080",
        "http://localhost:8081",
        "http://localhost:8083",
        "http://localhost:8084",
        "http://localhost:8085",
        "+"
      ],
      "defaultClientScopes": [
        "openid",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "internal-backend-client",
      "name": "OmniBus Internal Microservice Mesh",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "internal-service-mesh-secret-key-123",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles",
        "profile",
        "email"
      ]
    }
  ]
}
